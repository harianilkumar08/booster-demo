{
  "name": "booster-demo",
  "version": "0.1.0",
  "description": "Static concept demo of Booster, a flat £25 within-the-hour delivery add-on for luxury boutique checkouts.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "tsx scripts/serve.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "mockups": "playwright install chromium && tsx scripts/generate-mockups.ts",
    "emails": "tsx scripts/generate-emails.ts",
    "build:all": "next build && npm run mockups && npm run emails"
  },
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
